<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>               <string>AI Activity</string>
	<key>CFBundleDisplayName</key>        <string>AI Activity</string>
	<key>CFBundleIdentifier</key>         <string>com.foggylulu.ai-activity</string>
	<key>CFBundleExecutable</key>         <string>AIActivity</string>
	<key>CFBundlePackageType</key>        <string>APPL</string>
	<key>CFBundleShortVersionString</key> <string>@VERSION@</string>
	<key>CFBundleVersion</key>            <string>@BUILD@</string>
	<key>CFBundleIconFile</key>           <string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>     <string>14.0</string>
	<key>LSApplicationCategoryType</key>  <string>public.app-category.developer-tools</string>
	<!-- REQUIRED for a SwiftPM-built bundle: without it AppKit never starts. -->
	<key>NSPrincipalClass</key>           <string>NSApplication</string>
	<key>NSHighResolutionCapable</key>    <true/>
	<!-- It is a live monitor; do not let the system reap it. -->
	<key>NSSupportsAutomaticTermination</key> <false/>
	<key>NSSupportsSuddenTermination</key>    <false/>

	<!-- NO LSUIElement KEY. This is the deliberate difference from QwenMenu.app
	     and LLMMenu.app: this app is window-first and needs a Dock icon,
	     Cmd-Tab, and Spotlight launchability. -->

	<!-- The app talks plain HTTP to 127.0.0.1:56388 / :8080 / :11434. Without
	     this, URLSession silently refuses every load and the inference domain
	     shows nothing while looking like a network fault. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
</dict>
</plist>
